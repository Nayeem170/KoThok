import { ActionButton } from "button.slint";
import { CompactSlider } from "slider.slint";
import { SelectorRow } from "selector.slint";

export component ControlPanel inherits Rectangle {
    in property <bool> visible-flag: false;
    in property <bool> picker-active: false;
    in property <int> brightness-val: 50;
    in property <int> tts-speed: 50;
    in property <int> font-size-val: 36;
    in property <int> line-spacing-val: 140;
    in property <bool> text-justify: true;
    in property <int> margin-val: 24;
    in property <bool> auto-hide-header: false;
    in property <string> update-status: "";
    in property <string> device-model: "";
    in property <string> app-version: "";
    in property <string> free-space: "";
    in property <int> volume-val: 100;
    in property <string> tts-voice-label: "Emma (English)";
    in-out property <bool> wifi-on: true;
    in-out property <bool> bt-on: true;
    in-out property <string> wifi-name: "";
    in-out property <string> bt-name: "";
    in-out property <string> wifi-connected-name: "";
    in-out property <string> bt-connected-name: "";
    in-out property <string> sleep-label: "Off";
    in-out property <string> tts-sleep-label: "Off";
    in property <string> clock: "";
    in property <int> battery-pct: 0;
    in property <string> book-title: "";
    in property <string> book-author: "";
    in property <string> chapter-name: "";
    in property <image> book-title-img;
    in property <int> book-title-img-h: 0;
    in property <image> book-title-head-img;
    in property <int> book-title-head-img-h: 0;
    in property <image> book-author-img;
    in property <int> book-author-img-h: 0;
    in property <image> chapter-name-img;
    in property <int> chapter-name-img-h: 0;
    in property <image> book-cover-img;
    in property <int> page: 0;
    in property <int> page-count: 1;
    in property <bool> audio-mode: false;
    in property <bool> has-bookmark: false;
    in property <color> brand-green: #006A4E;
    in property <color> brand-red: #F42A41;
    in property <color> text-primary: #111111;
    in property <color> text-secondary: #666666;
    in property <color> text-hint: #999999;
    in property <color> bg-off: #1a1a1a;
    in property <color> bg-pressed: #555555;
    in property <color> separator: #999999;
    in property <color> track-color: #d0d0d0;

    callback quit();
    callback jump-to-reading();
    callback panel-close();
    callback panel-frac(int, float);
    callback panel-voice(string);
    callback panel-wifi-toggle();
    callback panel-bt-toggle();
    callback panel-wifi-cycle(string);
    callback panel-bt-cycle(string);
    callback panel-sleep-cycle(string);
    callback panel-tts-sleep-cycle(string);
    callback panel-text-align-toggle();
    callback panel-header-toggle();
    callback panel-check-updates();
    callback panel-reset-book();

    visible: root.visible-flag;
    background: #ffffff;

    // Shares the header geometry used by content.slint and audio_player.slint:
    // 110px tall, 76px buttons, 23px edge padding.
    Rectangle {
        y: 0px; height: 110px; width: root.width;
        background: #ffffff;

        Rectangle { y: 0px; height: 4px; width: root.width; background: root.brand-green; }

        ActionButton {
            x: root.width - 99px; y: 17px;
            width: 76px; height: 76px;
            icon: @image-url("assets/close.svg");
            bg: root.brand-red;
            radius: 38px;
            clicked => { root.panel-close(); }
        }

        // Rust rasterises this line for every book (see `set_book_meta`), so
        // Latin and Bengali titles come off the same engine and cannot sit on
        // different baselines. The Text below is only the picker's "Device
        // Settings" and the no-book case.
        //
        // Sized to the raster's own height and centred in the 76px button band
        // by hand. Handing it the full band and leaving the width unset instead
        // lets `image-fit: contain` scale the picture -- a 46px raster in a 76px
        // box comes out ~1.6x, which is what made the Bangla title read as both
        // bigger and off-line.
        if !root.picker-active && root.book-title-head-img-h > 0 : Image {
            source: root.book-title-head-img;
            x: 23px;
            y: 17px + (76px - root.book-title-head-img-h * 1px) / 2;
            width: root.width - 320px;
            height: root.book-title-head-img-h * 1px;
            image-fit: contain;
            horizontal-alignment: left;
        }

        if root.picker-active || root.book-title-head-img-h == 0 : HorizontalLayout {
            x: 23px; y: 17px;
            height: 76px;
            alignment: start;
            Text {
                text: root.picker-active ? "Device" : (root.book-title != "" ? root.book-title : "Reader");
                color: root.text-primary; font-size: 33px; font-weight: 700;
                overflow: elide;
                max-width: root.width - 320px;
            }
            Text {
                text: " Settings";
                color: root.text-secondary; font-size: 33px; font-weight: 700;
            }
        }

        Rectangle {
            y: 107px; height: 3px; width: root.width;
            background: root.track-color;
        }
    }

    // Device mode: brightness, auto-off, volume, wifi, bt.
    if root.picker-active : VerticalLayout {
        padding-left: 24px; padding-right: 24px;
        padding-top: 124px; padding-bottom: 24px;
        spacing: 14px;

        HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Text {
                text: "DISPLAY";
                color: root.text-hint; font-size: 20px; font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px; width: 100%;
                    background: root.separator;
                }
            }
        }

        CompactSlider {
            name: "Brightness";
            text-primary: root.text-primary;
            text-hint: root.text-hint;
            track-color: root.track-color;
            value-text: root.brightness-val + "%";
            fill-frac: root.brightness-val / 100.0;
            set-frac(f) => { root.panel-frac(0, f); }
        }

        SelectorRow {
            label: "Auto-off: " + root.sleep-label;
            on-state: true;
            connected: true;
            center-toggle: false;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-sleep-cycle("prev"); }
            next => { root.panel-sleep-cycle("next"); }
        }

        HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Text {
                text: "AUDIO";
                color: root.text-hint; font-size: 20px; font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px; width: 100%;
                    background: root.separator;
                }
            }
        }

        CompactSlider {
            name: "Volume";
            text-primary: root.text-primary;
            text-hint: root.text-hint;
            track-color: root.track-color;
            value-text: root.volume-val + "%";
            fill-frac: root.volume-val / 100.0;
            set-frac(f) => { root.panel-frac(3, f); }
        }

        HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Text {
                text: "NETWORK";
                color: root.text-hint; font-size: 20px; font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px; width: 100%;
                    background: root.separator;
                }
            }
        }

        SelectorRow {
            label: !root.wifi-on ? "WiFi Off"
                : (root.wifi-name != "" && root.wifi-name == root.wifi-connected-name
                   ? "connected to " + root.wifi-name
                   : (root.wifi-name != "" ? "connecting to " + root.wifi-name : "WiFi connecting..."));
            on-state: root.wifi-on;
            connected: root.wifi-on && root.wifi-name != "" && root.wifi-name == root.wifi-connected-name;
            center-toggle: true;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-wifi-cycle("prev"); }
            next => { root.panel-wifi-cycle("next"); }
            toggle => { root.panel-wifi-toggle(); }
        }

        SelectorRow {
            label: !root.bt-on ? "BT Off"
                : (root.bt-name != "" && root.bt-name == root.bt-connected-name
                   ? "connected to " + root.bt-name
                   : (root.bt-name != "" ? "connecting to " + root.bt-name : "BT connecting..."));
            on-state: root.bt-on;
            connected: root.bt-on && root.bt-name != "" && root.bt-name == root.bt-connected-name;
            center-toggle: true;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-bt-cycle("prev"); }
            next => { root.panel-bt-cycle("next"); }
            toggle => { root.panel-bt-toggle(); }
        }

        HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Text {
                text: "SYSTEM";
                color: root.text-hint; font-size: 20px; font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px; width: 100%;
                    background: root.separator;
                }
            }
        }

        ActionButton {
            height: 52px;
            label: "Check for updates";
            font-size: 22px;
            bg: root.brand-green;
            bg-pressed: root.bg-pressed;
            radius: 10px;
            clicked => { root.panel-check-updates(); }
        }

        Text {
            text: root.update-status;
            color: root.text-secondary; font-size: 19px;
            horizontal-alignment: left;
            visible: root.update-status != "";
        }

        Rectangle { vertical-stretch: 1; }

        // The About page said all of this in a screen of its own. Here it costs
        // nothing: this panel had ~550px of dead space under the last row.
        //
        // Laid out as aligned label/value pairs rather than a run of sentences
        // -- a fixed label column is what makes four unrelated facts scannable
        // instead of a paragraph to read.
        VerticalLayout {
            spacing: 8px;

            Rectangle { height: 2px; background: root.separator; }

            HorizontalLayout {
                height: 24px;
                spacing: 10px;
                Text {
                    text: "ABOUT THIS DEVICE";
                    color: root.text-hint; font-size: 20px; font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            info-device := HorizontalLayout {
                height: 32px;
                Text {
                    text: "Device";
                    color: root.text-hint; font-size: 20px;
                    vertical-alignment: center;
                    width: 200px;
                }
                Text {
                    text: root.device-model != "" ? root.device-model : "Kobo";
                    color: root.text-primary; font-size: 20px; font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                height: 32px;
                Text {
                    text: "KoThok";
                    color: root.text-hint; font-size: 20px;
                    vertical-alignment: center;
                    width: 200px;
                }
                Text {
                    text: root.app-version;
                    color: root.text-primary; font-size: 20px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                height: 32px;
                Text {
                    text: "Battery";
                    color: root.text-hint; font-size: 20px;
                    vertical-alignment: center;
                    width: 200px;
                }
                Text {
                    text: root.battery-pct + "%";
                    color: root.text-primary; font-size: 20px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                height: 32px;
                Text {
                    text: "Free space";
                    color: root.text-hint; font-size: 20px;
                    vertical-alignment: center;
                    width: 200px;
                }
                Text {
                    text: root.free-space != "" ? root.free-space : "-";
                    color: root.text-primary; font-size: 20px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        Text {
            text: "Swipe up to close";
            color: root.text-secondary; font-size: 18px;
            horizontal-alignment: left;
        }
    }

    // Book mode: font, voice, speed.
    if !root.picker-active : VerticalLayout {
        padding-left: 24px; padding-right: 24px;
        padding-top: 124px; padding-bottom: 24px;
        spacing: 14px;

        HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Text {
                text: "DISPLAY";
                color: root.text-hint; font-size: 20px; font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px; width: 100%;
                    background: root.separator;
                }
            }
        }

        CompactSlider {
            name: "Font";
            text-primary: root.text-primary;
            text-hint: root.text-hint;
            track-color: root.track-color;
            value-text: root.font-size-val + "px";
            fill-frac: (root.font-size-val - 20) / 40.0;
            set-frac(f) => { root.panel-frac(2, f); }
        }

        CompactSlider {
            name: "Line Spacing";
            text-primary: root.text-primary;
            text-hint: root.text-hint;
            track-color: root.track-color;
            value-text: root.line-spacing-val / 100 + "." + (root.line-spacing-val - (root.line-spacing-val / 100) * 100) / 10 + "x";
            fill-frac: (root.line-spacing-val - 100) / 100.0;  // 100-200 range → 0.0-1.0
            set-frac(f) => { root.panel-frac(4, f); }
        }

        CompactSlider {
            name: "Margins";
            text-primary: root.text-primary;
            text-hint: root.text-hint;
            track-color: root.track-color;
            value-text: root.margin-val + "px";
            fill-frac: (root.margin-val - 12) / 84.0;  // 12-96 range -> 0.0-1.0
            set-frac(f) => { root.panel-frac(5, f); }
        }

        SelectorRow {
            label: root.text-justify ? "Alignment: Justify" : "Alignment: Left";
            on-state: true;
            connected: true;
            center-toggle: false;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-text-align-toggle(); }
            next => { root.panel-text-align-toggle(); }
        }

        SelectorRow {
            label: root.auto-hide-header ? "Header: Auto-hide" : "Header: Always shown";
            on-state: true;
            connected: !root.auto-hide-header;
            center-toggle: true;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-header-toggle(); }
            next => { root.panel-header-toggle(); }
            toggle => { root.panel-header-toggle(); }
        }

        HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Text {
                text: "AUDIO";
                color: root.text-hint; font-size: 20px; font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                Rectangle {
                    y: (parent.height - 2px) / 2;
                    height: 2px; width: 100%;
                    background: root.separator;
                }
            }
        }

        SelectorRow {
            label: "Sleep timer: " + root.tts-sleep-label;
            on-state: true;
            connected: true;
            center-toggle: false;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-tts-sleep-cycle("prev"); }
            next => { root.panel-tts-sleep-cycle("next"); }
        }

        SelectorRow {
            label: root.tts-voice-label;
            on-state: true;
            connected: true;
            center-toggle: false;
            brand-green: root.brand-green;
            brand-red: root.brand-red;
            bg-off: root.bg-off;
            bg-pressed: root.bg-pressed;
            prev => { root.panel-voice("prev"); }
            next => { root.panel-voice("next"); }
        }

        CompactSlider {
            name: "Speed";
            text-primary: root.text-primary;
            text-hint: root.text-hint;
            track-color: root.track-color;
            value-text: (root.tts-speed == 50 ? "1.0x" : (root.tts-speed > 50 ? "+" : "") + (root.tts-speed - 50) * 2 + "%");
            fill-frac: root.tts-speed / 100.0;
            set-frac(f) => { root.panel-frac(1, f); }
        }

        Rectangle { vertical-stretch: 1; }

        ActionButton {
            height: 52px;
            label: "Reset this book to defaults";
            font-size: 20px;
            bg: root.bg-off;
            bg-pressed: root.bg-pressed;
            radius: 10px;
            clicked => { root.panel-reset-book(); }
        }

        // A plain Rectangle is not a layout, so the separator, the book block
        // and the "Swipe up to close" hint were three overlapping children all
        // pinned to its top-left corner -- the hint printed across the cover.
        VerticalLayout {
            spacing: 12px;

            Rectangle {
                height: 2px; background: root.separator;
            }

            HorizontalLayout {
            spacing: 16px;

            Image {
                // The cover is decoded at up to 200x300 (see `cover_image`),
                // so 260px tall stays inside the raster instead of upscaling.
                source: root.book-cover-img;
                height: 260px;
                width: root.book-cover-img.height > 0
                    ? min(200px, 260px * root.book-cover-img.width / root.book-cover-img.height)
                    : 174px;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: top;
                visible: root.book-cover-img.width > 0;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        HorizontalLayout {
                            alignment: start;
                            Image {
                                source: root.book-title-img;
                                height: root.book-title-img-h * 1px;
                                image-fit: contain;
                                vertical-alignment: top;
                                horizontal-stretch: 0;
                                visible: root.book-title-img-h > 0;
                            }
                        }
                        Text {
                            text: root.book-title != "" ? root.book-title : "-";
                            color: root.text-primary; font-size: 24px; font-weight: 700; wrap: word-wrap;
                            horizontal-alignment: left;
                            visible: root.book-title-img-h == 0;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Image {
                                source: root.book-author-img;
                                height: root.book-author-img-h * 1px;
                                image-fit: contain;
                                vertical-alignment: top;
                                horizontal-stretch: 0;
                                visible: root.book-author-img-h > 0;
                            }
                        }
                        Text {
                            text: root.book-author != "" ? root.book-author : "";
                            color: root.text-secondary; font-size: 19px; wrap: word-wrap;
                            horizontal-alignment: left;
                            visible: root.book-author != "" && root.book-author-img-h == 0;
                        }
                    }

                    Rectangle {
                        width: 160px; height: 40px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.separator;
                        background: #f2f2f2;
                        Text {
                            text: "Page " + (root.page + 1) + " / " + root.page-count;
                            color: root.text-primary; font-size: 18px;
                            horizontal-alignment: center; vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: 14px;
                    background: root.track-color;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: root.text-hint;
                    Rectangle {
                        x: 0px;
                        width: parent.width * (root.page-count > 0
                            ? clamp((root.page + 1) * 1.0 / root.page-count, 0.0, 1.0)
                            : 0.0);
                        height: 100%;
                        background: root.text-primary;
                        border-radius: 7px;
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    Image {
                        source: root.chapter-name-img;
                        height: root.chapter-name-img-h * 1px;
                        image-fit: contain;
                        vertical-alignment: top;
                        horizontal-stretch: 0;
                        visible: root.chapter-name-img-h > 0;
                    }
                }
                Text {
                    text: (root.chapter-name != "" ? root.chapter-name : "-");
                    color: root.text-secondary; font-size: 19px;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                    visible: root.chapter-name-img-h == 0;
                }
            }
        }
        }

        Text {
            text: "Swipe up to close";
            color: root.text-secondary; font-size: 18px;
            horizontal-alignment: left;
        }
    }
}
