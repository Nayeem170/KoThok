import { ActionButton } from "button.slint";

export component ChapterOverlay inherits Rectangle {
    in-out property <bool> visible-flag: false;
    in-out property <int> chapter-preview-idx: -1;
    in-out property <int> chapter-pending: -1;
    in property <int> current-chapter-idx: 0;
    in property <color> text-primary: #111111;
    in property <color> text-secondary: #666666;
    in property <color> brand-red: #F42A41;
    in property <color> track-color: #d0d0d0;

    in-out property <int> active-tab: 0;
    in-out property <bool> results-active: false;

    callback chapter-selected(int, int);
    callback close-to-book();
    callback tab-switch(int);
    callback back-from-results();

    visible: root.visible-flag;
    background: #ffffff;

    // Full-screen touch backdrop: blocks touches from reaching the underlying
    // progress bar while the chapter list is open.
    TouchArea {
        width: root.width;
        height: root.height;
    }

    // Shared header geometry: 110px tall, 76px buttons, 23px edge padding.
    Rectangle {
        y: 0px; height: 110px; width: root.width;
        background: #ffffff;

        // Back button (left). Dual purpose:
        // - Normal mode: close overlay
        // - Results mode: back from results (return to word list)
        ActionButton {
            x: 23px; y: 17px;
            width: 76px; height: 76px;
            icon: @image-url("assets/back.svg");
            bg: root.brand-red;
            radius: 38px;
            clicked => {
                root.chapter-preview-idx = -1;
                root.chapter-pending = -1;
                if root.results-active {
                    root.back-from-results();
                } else {
                    root.visible-flag = false;
                    root.close-to-book();
                }
            }
        }

        // Tab pills (center). Hidden in results mode.
        if !root.results-active : HorizontalLayout {
            x: 119px; width: root.width - 238px; height: 110px;
            alignment: center; spacing: 8px;

            Rectangle {
                width: 130px;
                height: 36px;
                border-radius: 18px;
                background: root.active-tab == 0 ? #000000 : transparent;
                border-width: root.active-tab == 0 ? 0px : 1px;
                border-color: #2104;

                chapters-touch := TouchArea {
                    clicked => {
                        if root.active-tab != 0 {
                            root.active-tab = 0;
                            root.tab-switch(0);
                        }
                    }
                }
                Text {
                    text: "Chapters";
                    color: root.active-tab == 0 ? #ffffff : #000000;
                    font-size: 20px; font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 110px;
                height: 36px;
                border-radius: 18px;
                background: root.active-tab == 1 ? #000000 : transparent;
                border-width: root.active-tab == 1 ? 0px : 1px;
                border-color: #2104;

                words-touch := TouchArea {
                    clicked => {
                        if root.active-tab != 1 {
                            root.active-tab = 1;
                            root.tab-switch(1);
                        }
                    }
                }
                Text {
                    text: "Words";
                    color: root.active-tab == 1 ? #ffffff : #000000;
                    font-size: 20px; font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Results context title (center, shown only in results mode).
        if root.results-active : Text {
            x: 119px; width: root.width - 238px; height: 110px;
            color: root.text-secondary; font-size: 24px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: elide;
        }

        // Close button (right).
        ActionButton {
            x: root.width - 99px; y: 17px;
            width: 76px; height: 76px;
            icon: @image-url("assets/close.svg");
            bg: root.brand-red;
            radius: 38px;
            clicked => {
                root.chapter-preview-idx = -1;
                root.chapter-pending = -1;
                root.visible-flag = false;
                root.close-to-book();
            }
        }
    }

    VerticalLayout {
        padding-left: 40px; padding-right: 40px;
        padding-top: 96px; padding-bottom: 36px;
        spacing: 16px;

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        ActionButton {
            height: 84px;
            label: "Open";
            font-size: 32px;
            clicked => {
                root.chapter-selected(root.chapter-preview-idx >= 0 ? root.chapter-preview-idx : root.current-chapter-idx, root.active-tab);
            }
        }
    }
}
